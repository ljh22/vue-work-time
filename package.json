{
	"name": "vite-work-time",
	"author": "liujiahui",
	"description": "vite+vue3+ts+element-plus",
	"private": true,
	"version": "1.0.7",
	"type": "module",
	"scripts": {
		"dev": "vite --open",
		"build": "rimraf dist && rimraf dist.zip && vue-tsc -b && vite build && node scripts/zip.js",
		"build:prod": "rimraf dist && rimraf dist.zip && vue-tsc -b && vite build --mode production && node scripts/zip.js",
		"preview": "vite preview",
		"analyze": "vite build --mode production && npx vite-bundle-analyzer dist",
		"clean": "rimraf dist",
		"type-check": "vue-tsc --noEmit"
	},
	"dependencies": {
		"@element-plus/icons-vue": "2.3.1",
		"dayjs": "1.11.13",
		"element-plus": "2.10.1",
		"vue": "3.5.16"
	},
	"devDependencies": {
		"@types/node": "24.0.1",
		"@vitejs/plugin-vue": "5.2.4",
		"@vue/tsconfig": "0.7.0",
		"less": "4.3.0",
		"less-loader": "12.3.0",
		"path": "0.12.7",
		"rimraf": "6.0.1",
		"sass": "1.89.2",
		"sass-loader": "16.0.5",
		"terser": "5.43.1",
		"typescript": "5.8.3",
		"unplugin-auto-import": "19.3.0",
		"unplugin-vue-components": "28.7.0",
		"vite": "6.3.5",
		"vite-bundle-analyzer": "0.23.0",
		"vue-tsc": "2.2.10"
	}
}
