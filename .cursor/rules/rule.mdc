## 代码输出标准

### React 组件标准

```tsx
// ✅ 好的示例：完整的组件 + 状态覆盖
interface ButtonProps {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  loading?: boolean;
  disabled?: boolean;
  children: React.ReactNode;
  onClick?: () => void;
}

export const Button: React.FC<ButtonProps> = ({
  variant = 'primary',
  size = 'md',
  loading = false,
  disabled = false,
  children,
  onClick,
}) => {
  return (
    <button
      className={cn('btn', `btn-${variant}`, `btn-${size}`, { loading, disabled })}
      disabled={disabled || loading}
      onClick={onClick}
    >
      {loading ? <Spinner /> : children}
    </button>
  );
};

// ❌ 坏的示例：缺少状态、不考虑边界
const Button = ({ children }) => (
  <button>{children}</button>
);
```

### CSS 规范

```css
/* ✅ 使用设计系统变量 */
.button {
  height: 40px;
  padding: 0 16px;
  font-size: 14px;
  border-radius: 8px;
  transition: all 0.2s ease;
}

.button:hover {
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ❌ 硬编码值、缺乏动效 */
.button {
  height: 40px;
  padding: 0 16px;
}
```

